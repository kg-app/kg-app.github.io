rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/notes/{noteId}/{imageId} {
      allow read: if (request.auth != null && request.auth.uid == userId)
                     || firestore.get(/databases/(default)/documents/users/$(userId)/notes/$(noteId)).data.public == true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
