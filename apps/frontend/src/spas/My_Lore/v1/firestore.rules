rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/canvases/{canvasId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/notes/{noteId} {
      allow read: if (request.auth != null && request.auth.uid == userId)
                     || resource.data.public == true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ---------------- Lore app ----------------
    // A "journal" lives at users/{ownerId}/... . The owner (uid == ownerId) has
    // full access. Collaborators (spouse, kids) are granted access via a share
    // doc keyed by their email, written only by the owner from the admin screen.

    function isOwner(ownerId) {
      return request.auth != null && request.auth.uid == ownerId;
    }
    function shareRef(ownerId) {
      return /databases/$(database)/documents/users/$(ownerId)/shares/$(request.auth.token.email);
    }
    function hasActiveShare(ownerId) {
      return request.auth != null && request.auth.token.email != null
        && exists(shareRef(ownerId))
        && get(shareRef(ownerId)).data.status == 'active';
    }
    function canEditShare(ownerId) {
      return hasActiveShare(ownerId) && get(shareRef(ownerId)).data.canEdit == true;
    }

    match /users/{ownerId}/children/{childId} {
      allow read: if isOwner(ownerId) || hasActiveShare(ownerId);
      allow write: if isOwner(ownerId); // add/remove child is an admin-only action
    }

    match /users/{ownerId}/entries/{entryId} {
      allow read: if isOwner(ownerId) || hasActiveShare(ownerId);
      allow create, update: if isOwner(ownerId) || canEditShare(ownerId);
      allow delete: if isOwner(ownerId); // deleting entries stays admin-only
    }

    match /users/{ownerId}/shares/{shareEmail} {
      // Owner manages the list; an invitee may read only their own share doc
      // directly (e.g. to confirm status), matched by document id == their email.
      allow read: if isOwner(ownerId)
                     || (request.auth != null && request.auth.token.email == shareEmail);
      allow write: if isOwner(ownerId);
    }

    // Lets a signed-in collaborator discover which journal(s) they've been
    // invited into via a collectionGroup('shares') query filtered on their
    // own email — never exposes other people's share docs.
    match /{path=**}/shares/{shareEmail} {
      allow read: if request.auth != null
                     && resource.data.email == request.auth.token.email;
    }

    // ---------------- E2EE key material ----------------
    // Each signed-in user publishes their own RSA-OAEP public key here so
    // journal owners can wrap the journal's AES key for them. Readable by any
    // signed-in user (needed to look up an invitee's key by email); writable
    // only by that email's own account.
    match /publicKeys/{email} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == email;
    }

    // The owner's own wrapped copy of the journal's AES data key.
    match /users/{ownerId}/keys/{doc} {
      allow read, write: if isOwner(ownerId);
    }
  }
}
