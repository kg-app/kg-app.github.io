rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/notes/{noteId}/{imageId} {
      allow read: if (request.auth != null && request.auth.uid == userId)
                     || firestore.get(/databases/(default)/documents/users/$(userId)/notes/$(noteId)).data.public == true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ---------------- Lore app ----------------
    // Media for an entry lives at users/{ownerId}/entries/{entryId}/{fileName}.
    // Mirrors the Firestore rules: owner always has access; a collaborator
    // needs an active share doc, and needs canEdit:true to upload/replace files.
    match /users/{ownerId}/entries/{entryId}/{fileName} {
      allow read: if request.auth != null &&
        (request.auth.uid == ownerId ||
         (request.auth.token.email != null &&
          firestore.get(/databases/(default)/documents/users/$(ownerId)/shares/$(request.auth.token.email)).data.status == 'active'));

      allow write: if request.auth != null &&
        (request.auth.uid == ownerId ||
         (request.auth.token.email != null &&
          firestore.get(/databases/(default)/documents/users/$(ownerId)/shares/$(request.auth.token.email)).data.status == 'active' &&
          firestore.get(/databases/(default)/documents/users/$(ownerId)/shares/$(request.auth.token.email)).data.canEdit == true));
    }
  }
}
